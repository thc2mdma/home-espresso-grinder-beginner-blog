---
import { Font } from "astro:assets";
import { siteMeta } from "../site";

interface Props {
  title: string;
  description?: string;
  heroImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteMeta.description,
  heroImage = siteMeta.ogImage,
  ogType = "website",
  jsonLd,
} = Astro.props;

// Always self-canonicalise against the configured site URL. Front matter can
// carry a canonicalUrl from whatever domain the post was published under; using
// it would point search engines at a host this build may no longer serve.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

// Search engines truncate long descriptions; keep the tag inside ~130 chars
// without cutting a word in half.
const metaDescription =
  description.length <= 130
    ? description
    : `${description.slice(0, 130).replace(/\s+\S*$/, "")}…`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMeta.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={heroImage} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/">{siteMeta.title}</a>
        <nav class="site-nav">
          <a href="/blog/">Archive</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4efe6;
    --panel: rgba(255, 251, 245, 0.9);
    --panel-strong: #fffaf2;
    --border: rgba(52, 36, 21, 0.12);
    --text: #23180f;
    --muted: #6c5c4f;
    --accent: #c45d2f;
    --accent-soft: #f2d3c4;
    --shadow: 0 24px 60px rgba(48, 31, 16, 0.08);
    --content-width: 72rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    font-family: var(--font-body), system-ui, sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(196, 93, 47, 0.14), transparent 30rem),
      linear-gradient(180deg, #f8f3eb 0%, var(--bg) 60%, #efe7dc 100%);
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .page-shell {
    width: min(calc(100% - 2rem), var(--content-width));
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0 2.25rem;
  }

  .brand {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .site-nav {
    display: flex;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Comfortable tap target on touch screens without changing the visual weight. */
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.55);
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.4fr 0.85fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .hero-card,
  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
  }

  .hero-card {
    padding: 2rem;
  }

  .hero h1,
  .section-title,
  .article-title,
  article h1,
  article h2,
  article h3 {
    font-family: var(--font-display), Georgia, serif;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .hero h1 {
    margin: 1rem 0 1rem;
    font-size: clamp(3rem, 7vw, 5.6rem);
  }

  .hero p {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-sidebar {
    display: grid;
    gap: 1rem;
  }

  .hero-sidebar .panel {
    padding: 1.25rem;
  }

  .section {
    margin-top: 2rem;
  }

  .section-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
  }

  .post-card {
    grid-column: span 6;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: 1.35rem;
    background: var(--panel-strong);
    box-shadow: var(--shadow);
  }

  .post-card.featured {
    grid-column: span 12;
    padding: 1.75rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .article-title {
    margin: 0.9rem 0;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
  }

  .post-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .tag {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: #7d3412;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .archive-list {
    display: grid;
    gap: 1rem;
  }

  .archive-item {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: rgba(255, 251, 245, 0.72);
  }

  article {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    box-shadow: var(--shadow);
  }

  article h1 {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    margin-bottom: 1rem;
  }

  article h2 {
    margin-top: 2.4rem;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }

  article h3 {
    margin-top: 1.5rem;
    font-size: 1.35rem;
  }

  article p,
  article li {
    color: #35271a;
    line-height: 1.85;
    font-size: 1.02rem;
  }

  article ul,
  article ol {
    padding-left: 1.2rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-header p {
    color: var(--muted);
  }

  .not-found {
    max-width: 44rem;
    padding: 2rem;
    margin: 0 auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    text-align: center;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .post-card,
    .post-card.featured {
      grid-column: span 12;
    }

    article {
      padding: 1.4rem;
    }
  }
</style>

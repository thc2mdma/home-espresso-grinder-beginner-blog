---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteMeta } from "../site";
---

<BaseLayout title={`Page Not Found | ${siteMeta.title}`} description="The page you requested could not be found.">
  <section class="not-found">
    <span class="eyebrow">404</span>
    <h1 class="section-title" style="margin-top: 1rem;">Page not found</h1>
    <p style="color: var(--muted); line-height: 1.7;">
      This route does not exist in the current build. Return to the archive or homepage to keep browsing.
    </p>
    <div style="margin-top: 1.25rem; display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a class="tag" href="/">Home</a>
      <a class="tag" href="/blog/">Archive</a>
    </div>
  </section>
</BaseLayout>

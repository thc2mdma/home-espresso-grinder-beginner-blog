---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteMeta } from "../../site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteUrl = new URL("/", Astro.site ?? Astro.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  url: pageUrl,
  keywords: post.data.tags,
  ...(post.data.heroImage ? { image: post.data.heroImage } : {}),
  isPartOf: { "@type": "Blog", name: siteMeta.title, url: siteUrl },
  publisher: { "@type": "Organization", name: siteMeta.title, url: siteUrl },
};
---

<BaseLayout
  title={`${post.data.title} | ${siteMeta.title}`}
  description={post.data.description}
  heroImage={post.data.heroImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="article-header">
      <div class="post-meta">
        <span>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
        {post.data.updatedDate && (
          <span>
            Updated {post.data.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </span>
        )}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="tag-list">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <Content />
  </article>
</BaseLayout>

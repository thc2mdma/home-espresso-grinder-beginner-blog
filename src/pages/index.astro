---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { siteMeta } from "../site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featuredPost, ...recentPosts] = posts;

// The hero speaks about THIS blog, never about the starter template: everything
// below is derived from site.ts (rewritten at provision time) and the posts.
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 6)
  .map(([tag]) => tag);

const postCount = posts.length;
const eyebrow = postCount === 0 ? "New blog" : `${postCount} article${postCount === 1 ? "" : "s"}`;
const latestDate = featuredPost?.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const siteUrl = new URL("/", Astro.site ?? Astro.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: siteMeta.title,
  description: siteMeta.description,
  url: siteUrl,
  inLanguage: "en",
  blogPost: posts.slice(0, 10).map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).toString(),
  })),
};
---

<BaseLayout
  title={siteMeta.title}
  description={siteMeta.description}
  jsonLd={jsonLd}
>
  <section class:list={["hero", postCount === 0 && "hero--solo"]}>
    <div class="hero-card">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class:list={[siteMeta.title.length > 28 && "hero-title--long"]}>{siteMeta.title}</h1>
      <p>{siteMeta.description}</p>
    </div>
    {postCount > 0 && (
      <div class="hero-sidebar">
        {topTags.length > 0 && (
          <aside class="panel">
            <span class="eyebrow">Topics</span>
            <div class="tag-list panel-tags">
              {topTags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </aside>
        )}
        <aside class="panel">
          <span class="eyebrow">Archive</span>
          <p class="panel-text">
            {postCount} article{postCount === 1 ? "" : "s"} published{latestDate ? `, latest ${latestDate}` : ""}.
          </p>
          <a class="panel-link" href="/blog/">Browse every post &rarr;</a>
        </aside>
      </div>
    )}
  </section>

  {featuredPost && (
    <section class="section">
      <h2 class="section-title">Featured</h2>
      <div class="card-grid">
        <PostCard
          href={`/blog/${featuredPost.id}/`}
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          pubDate={featuredPost.data.pubDate}
          tags={featuredPost.data.tags}
          featured={true}
        />
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="section">
      <h2 class="section-title">Latest posts</h2>
      <div class="card-grid">
        {recentPosts.map((post) => (
          <PostCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero--solo {
    grid-template-columns: 1fr;
  }

  .hero-title--long {
    font-size: clamp(2.4rem, 5vw, 3.9rem);
  }

  .panel-tags {
    margin-top: 0.9rem;
  }

  .panel-text {
    margin: 0.9rem 0 0.75rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .panel-link {
    font-weight: 600;
    text-decoration: none;
  }
</style>
